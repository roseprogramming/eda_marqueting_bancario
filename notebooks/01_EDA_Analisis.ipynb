    ").astype('Int8')\n",
    "print(\"Columna 'y' convertida a tipo Int8 correctamente\\n\")\n",
    "\n",
    "# Crear segmento_edad si falta y fijar orden categórico\n",
    "if 'segmento_edad' not in df_perfil_cliente.columns:\n",
    "    df_perfil_cliente['segmento_edad'] = pd.cut(\n",
